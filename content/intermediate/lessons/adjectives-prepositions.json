  {
   "id": "i-les-adj-01",
   "level": "intermediate",
   "module": "adjectives-prepositions",
   "unit": "describing-and-locating",
   "title": {
    "en": "Adjectives and agreement",
    "ar": "الصِّفَةُ وَالمُطَابَقَة"
   },
   "objectives": [
    {
     "en": "Place adjectives after the noun",
     "ar": "وضع الصفة بعد الاسم"
    },
    {
     "en": "Match gender and definiteness",
     "ar": "المطابقة في التذكير والتأنيث والتعريف"
    }
   ],
   "prerequisites": [
    "i-les-verbs-05"
   ],
   "minutes": 10,
   "review": "unreviewed",
   "explanation": [
    {
     "en": "An adjective comes after the noun and agrees with it in gender and in being definite or indefinite: كِتَابٌ كَبِيرٌ “a big book”; قِطَّةٌ كَبِيرَةٌ “a big cat” (the feminine takes ة); الكِتَابُ الكَبِيرُ “the big book” (both have ال).",
     "ar": "تأتي الصفة بعد الاسم وتطابقه في التذكير والتأنيث وفي التعريف والتنكير: كِتَابٌ كَبِيرٌ، قِطَّةٌ كَبِيرَةٌ (المؤنّث بالتاء المربوطة)، الكِتَابُ الكَبِيرُ (كلاهما بـ «ال»)."
    },
    {
     "en": "Common adjectives: كَبِيرٌ big, صَغِيرٌ small, جَدِيدٌ new, جَمِيلٌ beautiful.",
     "ar": "من الصفات الشائعة: كَبِيرٌ، صَغِيرٌ، جَدِيدٌ، جَمِيلٌ."
    }
   ],
   "examples": [
    {
     "ar": "كِتَابٌ كَبِيرٌ",
     "tr": "kitābun kabīrun",
     "en": "a big book"
    },
    {
     "ar": "قِطَّةٌ صَغِيرَةٌ",
     "tr": "qiṭṭatun ṣaghīratun",
     "en": "a small cat"
    },
    {
     "ar": "بَيْتٌ جَدِيدٌ",
     "tr": "baytun jadīdun",
     "en": "a new house"
    },
    {
     "ar": "طَاوِلَةٌ جَمِيلَةٌ",
     "tr": "ṭāwilatun jamīlatun",
     "en": "a beautiful table"
    },
    {
     "ar": "الكِتَابُ الكَبِيرُ",
     "tr": "al-kitābu l-kabīru",
     "en": "the big book"
    }
   ],
