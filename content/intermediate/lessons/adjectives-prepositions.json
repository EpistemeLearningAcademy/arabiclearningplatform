   "title": {
    "en": "Phrase or sentence?",
    "ar": "عِبَارَةٌ أَمْ جُمْلَة؟"
   },
   "objectives": [
    {
     "en": "Tell “the big book” from “the book is big”",
     "ar": "التمييز بين «الكتاب الكبير» و«الكتاب كبير»"
    }
   ],
   "prerequisites": [
    "i-les-adj-01"
   ],
   "minutes": 8,
   "review": "unreviewed",
   "explanation": [
    {
     "en": "If the noun and adjective are both definite, you get a phrase: الكِتَابُ الكَبِيرُ “the big book”. If the noun is definite and the adjective is not, you get a sentence: الكِتَابُ كَبِيرٌ “The book is big.”",
     "ar": "إذا كان الاسم والصفة معرّفين فهما عبارة: الكِتَابُ الكَبِيرُ. وإذا كان الاسم معرّفًا والصفة نكرة فهما جملة: الكِتَابُ كَبِيرٌ."
    },
    {
     "en": "With هٰذَا: هٰذَا كِتَابٌ كَبِيرٌ “This is a big book.” but هٰذَا الكِتَابُ كَبِيرٌ “This book is big.”",
     "ar": "مع هٰذَا: هٰذَا كِتَابٌ كَبِيرٌ، لكن هٰذَا الكِتَابُ كَبِيرٌ."
    }
   ],
   "examples": [
    {
     "ar": "الكِتَابُ الكَبِيرُ",
     "tr": "al-kitābu l-kabīru",
     "en": "the big book (phrase)"
    },
    {
     "ar": "الكِتَابُ كَبِيرٌ",
     "tr": "al-kitābu kabīrun",
     "en": "The book is big. (sentence)"
    },
    {
     "ar": "هٰذَا كِتَابٌ كَبِيرٌ",
     "tr": "hādhā kitābun kabīrun",
     "en": "This is a big book."
    },
    {
     "ar": "هٰذَا الكِتَابُ كَبِيرٌ",
     "tr": "hādhā l-kitābu kabīrun",
     "en": "This book is big."
    }
   ],
