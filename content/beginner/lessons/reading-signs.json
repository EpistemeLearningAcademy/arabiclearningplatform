   "unit": "reading-signs",
   "title": {
    "en": "Sukūn: no vowel",
    "ar": "السُّكُون"
   },
   "objectives": [
    {
     "en": "Recognise the sukūn above a letter",
     "ar": "التعرّف إلى السكون فوق الحرف"
    },
    {
     "en": "Read words that contain a sukūn",
     "ar": "قراءة كلمات فيها سكون"
    }
   ],
   "prerequisites": [
    "b-les-vowels-08"
   ],
   "minutes": 8,
   "review": "unreviewed",
   "explanation": [
    {
     "en": "Sukūn is a small circle written above a letter. It means the letter has no vowel: مِنْ is read “min”, with the n closing the syllable.",
     "ar": "السكون دائرة صغيرة تُكتب فوق الحرف، وتدلّ على أنّ الحرف لا حركة له: مِنْ تُقرأ «min» وتنتهي بالنون ساكنةً."
    },
    {
     "en": "A letter with sukūn joins the vowel sound before it; it does not start a new syllable.",
     "ar": "الحرف الساكن يتصل بالصوت الذي قبله ولا يبدأ مقطعًا جديدًا."
    }
   ],
   "examples": [
    {
     "ar": "مِنْ",
     "tr": "min",
     "en": "from"
    },
    {
     "ar": "هَلْ",
     "tr": "hal",
     "en": "(question word: “is/does…?”)"
    },
    {
     "ar": "كَمْ",
     "tr": "kam",
     "en": "how many"
    }
   ],
