  {
   "id": "b-les-vowels-05",
   "level": "beginner",
   "module": "long-vowels",
   "unit": "reading-with-vowels",
   "title": {
    "en": "Long vowel: ā (alif)",
    "ar": "المدّ بالألف"
   },
   "objectives": [
    {
     "en": "Recognise ا as the lengthener of fatḥa",
     "ar": "التعرّف إلى حرف ا بوصفه يمدّ الفتحة"
    },
    {
     "en": "Tell short “a” from long “ā” when reading",
     "ar": "التمييز بين «a» القصيرة و«ā» الطويلة عند القراءة"
    }
   ],
   "prerequisites": [
    "b-les-vowels-04"
   ],
   "minutes": 8,
   "review": "unreviewed",
   "explanation": [
    {
     "en": "A fatḥa followed by the letter alif (ا) makes a long “ā”, held about twice as long as short “a”: بَا is read “bā”.",
     "ar": "إذا جاءت الألف (ا) بعد الفتحة صار الصوت «ā» طويلًا، ويُمَدّ نحو ضعف مدة الفتحة القصيرة: بَا تُقرأ «bā»."
    },
    {
     "en": "Alif takes no vowel mark here; it only lengthens the fatḥa before it.",
     "ar": "لا تحمل الألف هنا حركة، وإنما تمدّ الفتحة التي قبلها."
    }
   ],
   "examples": [
    {
     "ar": "بَا",
     "tr": "bā",
     "en": "syllable"
    },
    {
     "ar": "تَا",
     "tr": "tā",
     "en": "syllable"
    },
    {
     "ar": "مَا",
     "tr": "mā",
