      "ar": "أَنْ + المضارع المنصوب."
     }
    },
    {
     "id": "q5",
     "prompt": {
      "en": "After لَنْ the verb ends with…",
      "ar": "بعد لَنْ ينتهي الفعل بـ…"
     },
     "promptAr": "",
     "options": [
      {
       "text": {
        "en": "fatḥa",
        "ar": "فتحة"
       }
      },
      {
       "text": {
        "en": "ḍamma",
        "ar": "ضمّة"
       }
      },
      {
       "text": {
        "en": "sukūn",
        "ar": "سكون"
       }
      }
     ],
     "answer": 0,
     "explanation": {
      "en": "لَنْ takes the subjunctive.",
      "ar": "لَنْ تنصب المضارع."
     }
    },
    {
     "id": "q6",
     "prompt": {
      "en": "What mood is يَكْتُبُ?",
      "ar": "ما حالة يَكْتُبُ؟"
     },
     "promptAr": "يَكْتُبُ",
     "options": [
      {
       "text": {
        "en": "Indicative",
        "ar": "مرفوع"
       }
      },
      {
