      "ar": "الضمّة = الرفع."
     }
    }
   ]
  },
  {
   "id": "a-les-mood-02",
   "level": "advanced",
   "module": "moods",
   "unit": "moods-and-commands",
   "title": {
    "en": "Negation in every tense",
    "ar": "النَّفْيُ فِي الأَزْمِنَة"
   },
   "objectives": [
    {
     "en": "Choose the right negative word for past, present and future",
     "ar": "اختيار أداة النفي المناسبة للماضي والمضارع والمستقبل"
    }
   ],
   "prerequisites": [
    "a-les-mood-01"
   ],
   "minutes": 10,
   "review": "unreviewed",
   "explanation": [
    {
     "en": "Past: لَمْ + jussive, or مَا + past verb: لَمْ يَكْتُبْ / مَا كَتَبَ “he did not write”. Present: لَا + indicative: لَا يَكْتُبُ “he does not write”. Future: لَنْ + subjunctive: لَنْ يَكْتُبَ “he will not write”.",
     "ar": "الماضي: لَمْ + المضارع المجزوم أو مَا + الماضي: لَمْ يَكْتُبْ / مَا كَتَبَ. المضارع: لَا + المضارع المرفوع: لَا يَكْتُبُ. المستقبل: لَنْ + المضارع المنصوب: لَنْ يَكْتُبَ."
    }
   ],
   "examples": [
    {
     "ar": "لَمْ يَكْتُبْ",
     "tr": "lam yaktub",
     "en": "he did not write"
    },
    {
     "ar": "مَا كَتَبَ",
     "tr": "mā kataba",
     "en": "he did not write"
    },
    {
     "ar": "لَا يَكْتُبُ",
     "tr": "lā yaktubu",
     "en": "he does not write"
    },
    {
     "ar": "لَنْ يَكْتُبَ",
     "tr": "lan yaktuba",
     "en": "he will not write"
    }
   ],
   "practice": [
