       "ar": true
      },
      {
       "text": "ـْ",
       "ar": true
      }
     ],
     "answer": 0,
     "explanation": {
      "en": "Subjunctive = fatḥa.",
      "ar": "النصب = فتحة."
     }
    },
    {
     "id": "q2",
     "prompt": {
      "en": "Which particle is followed by the jussive?",
      "ar": "أيُّ أداة يأتي بعدها الجزم؟"
     },
     "promptAr": "",
     "options": [
      {
       "text": "لَمْ",
       "ar": true
      },
      {
       "text": "لَنْ",
       "ar": true
      },
      {
       "text": "أَنْ",
       "ar": true
      }
     ],
     "answer": 0,
     "explanation": {
      "en": "After لَمْ the verb has sukūn.",
      "ar": "بعد لَمْ يكون الفعل ساكنًا."
     }
    },
    {
     "id": "q3",
     "prompt": {
      "en": "How do you read this?",
      "ar": "كيف تقرأ هذا؟"
     },
     "promptAr": "يَكْتُبْ",
     "options": [
      {
       "text": "yaktub",
       "ar": false
      },
      {
       "text": "yaktubu",
       "ar": false
      },
      {
       "text": "yaktuba",
       "ar": false
      }
     ],
     "answer": 0,
     "explanation": {
      "en": "The sukūn gives “yaktub”.",
      "ar": "السكون يعطي «yaktub»."
     }
    },
    {
     "id": "q4",
     "prompt": {
      "en": "What does أُرِيدُ أَنْ أَكْتُبَ mean?",
      "ar": "ماذا تعني أُرِيدُ أَنْ أَكْتُبَ؟"
