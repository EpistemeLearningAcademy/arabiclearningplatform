     "tr": "al-waladu ṭālibun",
     "en": "subject: الوَلَدُ; predicate: طَالِبٌ"
    },
    {
     "ar": "الكِتَابُ كَبِيرٌ",
     "tr": "al-kitābu kabīrun",
