    "ar": "المَنْصُوب: المَفْعُولُ بِهِ"
   },
   "objectives": [
    {
     "en": "Find the object of a verb",
     "ar": "تحديد المفعول به"
    },
    {
     "en": "Read accusative endings",
     "ar": "قراءة علامات النصب"
