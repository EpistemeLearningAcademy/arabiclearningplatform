   "unit": "sentence-structures",
   "title": {
    "en": "The sound feminine plural by case",
    "ar": "جَمْعُ المُؤَنَّثِ السَّالِمُ وَالإِعْرَاب"
   },
   "objectives": [
    {
     "en": "Read the sound feminine plural in each case",
     "ar": "قراءة جمع المؤنّث السالم في الحالات"
    },
    {
     "en": "Know that its accusative takes kasra",
     "ar": "معرفة أنّ نصبه بالكسرة"
    }
   ],
   "prerequisites": [
    "a-les-grammar-review"
   ],
   "minutes": 10,
   "review": "unreviewed",
   "explanation": [
    {
     "en": "The sound feminine plural (-āt) ends in ـَاتٌ in the nominative. In the genitive and the accusative it takes kasra: ـَاتِ / ـَاتٍ. So its accusative is NOT marked with fatḥa.",
     "ar": "جمع المؤنّث السالم يُرفع بالضمّة: ـَاتٌ، ويُجرّ بالكسرة: ـَاتِ. ويُنصب أيضًا بالكسرة لا بالفتحة."
    },
    {
     "en": "Compare: ذَهَبَتِ الطَّالِبَاتُ (nominative); كِتَابُ الطَّالِبَاتِ (genitive); أَكَلَ الوَلَدُ التُّفَّاحَاتِ “The boy ate the apples” (accusative, with kasra).",
     "ar": "قارن: ذَهَبَتِ الطَّالِبَاتُ (رفع)؛ كِتَابُ الطَّالِبَاتِ (جرّ)؛ أَكَلَ الوَلَدُ التُّفَّاحَاتِ (نصب بالكسرة)."
    }
   ],
   "examples": [
    {
     "ar": "ذَهَبَتِ الطَّالِبَاتُ",
     "tr": "dhahabati ṭ-ṭālibātu",
     "en": "The female students went."
    },
    {
     "ar": "كِتَابُ الطَّالِبَاتِ",
     "tr": "kitābu ṭ-ṭālibāti",
     "en": "the female students’ book"
    },
    {
     "ar": "أَكَلَ الوَلَدُ التُّفَّاحَاتِ",
     "tr": "akala l-waladu t-tuffāḥāti",
     "en": "The boy ate the apples."
    }
   ],
