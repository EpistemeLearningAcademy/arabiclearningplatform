{
  "name": "@greenfield/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
"dev": "npm run build && npm start",    "build": "tsc --project tsconfig.json",
    "start": "node --import ./load-env.mjs dist/index.js",
    "bootstrap:admin": "node dist/bootstrap-admin.js",
    "school:add": "node dist/add-school-admin.js",
    "test": "npm run build && node --test dist/*.test.js",
    "test:db": "npm run build && node --test dist/*.test.js",
    "test:api:db": "npm run build && node --test dist/authorization.api.test.js"
  },
  "dependencies": {
    "@greenfield/database": "0.1.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0"
  }
}
